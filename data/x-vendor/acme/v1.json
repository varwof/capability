          "max": 1000000
        }
      }
    },
    {
      "id": "order:approve",
      "description": "审批订单",
      "parameters": {
        "threshold": {
          "type": "int",
          "description": "审批阈值（元）",
          "min": 1,
          "required": true
        }
      }
    },
    {
      "id": "inventory:read",
      "description": "查询库存"
    }
  ]
