{
  "scheme_id": "oracle/mysql",
  "name": "MySQL",
  "version": "1.0.0",
  "description": "MySQL/MariaDB database operation permissions",
  "vendor": "oracle",
  "product": "mysql",
  "author": "community",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mysql/mysql-server",
  "capabilities": [
    {
      "id": "query:users",
      "description": "Query the users table",
      "parameters": {
        "max_rows": {
          "type": "int",
          "description": "Maximum number of rows returned",
          "default": 1000,
          "min": 1,
          "max": 10000
        }
      }
    },
    {
      "id": "query:orders",
      "description": "Query the orders table",
      "parameters": {
        "max_rows": {
          "type": "int",
          "description": "Maximum number of rows returned",
          "default": 500,
          "min": 1,
          "max": 5000
        }
      }
    },
    {
      "id": "write:orders",
      "description": "Create/update orders"
    },
    {
      "id": "delete:logs",
      "description": "Delete log records",
      "parameters": {
        "older_than_days": {
          "type": "int",
          "description": "Only delete logs older than N days",
          "min": 30,
          "required": true
        }
      }
    },
    {
      "id": "admin:backup",
      "description": "Perform a database backup"
    }
  ]
}
