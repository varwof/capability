      ],
      "related": [
        "ca:issue-sub"
      ]
    },
    {
      "id": "cross-cert:revoke",
      "description": "吊销交叉证书",
      "summary": "吊销交叉证书",
      "usage": "需要撤销跨域信任桥接时使用。",
