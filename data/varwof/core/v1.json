        "trust:delete"
      ]
    },
    {
      "id": "trust:list",
      "description": "查询信任锚",
      "summary": "查询信任锚列表",
      "usage": "需要查看当前信任哪些外部 CA 时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
