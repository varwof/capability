{
  "scheme_id": "varwof/gateway",
  "name": "Varwof Gateway",
  "version": "1.1.0",
  "description": "Varwof 网关操作权限（管理 API + 数据面）",
  "vendor": "varwof",
  "product": "gateway",
  "author": "varwof",
  "license": "Apache-2.0",
  "homepage": "https://github.com/varwof/gateway",
  "capabilities": [
    {
      "id": "proxy:http",
      "description": "HTTP/HTTPS 反向代理数据面",
      "summary": "HTTP/HTTPS 反向代理数据面",
      "usage": "需要经网关访问 HTTP/HTTPS 后端服务（Web 应用、REST API）时使用。最常见的数据面能力。",
      "when_not": "TCP/UDP 专有协议服务不需要；纯管理操作不需要。",
      "examples": [
        "经网关访问内网 Web 服务",
        "调用后端 REST API"
      ],
      "related": [
        "proxy:websocket",
        "proxy:grpc"
      ]
    },
    {
      "id": "proxy:tcp",
      "description": "TCP 透明代理数据面",
      "summary": "TCP 透明代理数据面",
      "usage": "需要转发任意 TCP 协议（SSH、数据库、自定义协议）时使用。",
      "when_not": "HTTP 服务用 proxy:http 即可。",
      "examples": [
        "经网关访问 SSH 服务",
        "转发 MySQL 连接"
      ],
      "related": [
        "proxy:http"
      ]
    },
    {
      "id": "proxy:udp",
      "description": "UDP 转发数据面",
      "summary": "UDP 转发数据面",
      "usage": "需要转发 UDP 流量（DNS、音视频、游戏）时使用。",
      "when_not": "TCP/HTTP 服务不需要。",
      "examples": [
        "经网关转发 DNS 查询"
      ],
      "related": [
        "proxy:quic"
      ]
    },
    {
      "id": "proxy:quic",
      "description": "QUIC/HTTP3 代理数据面",
      "summary": "QUIC/HTTP3 代理数据面",
      "usage": "需要支持 QUIC/HTTP3 客户端访问时使用。",
      "when_not": "传统 TCP 客户端不需要。",
      "examples": [
        "支持 HTTP3 的 Web 服务"
      ],
      "related": [
        "proxy:udp",
        "proxy:http"
      ]
    },
    {
      "id": "proxy:websocket",
      "description": "WebSocket 代理数据面",
      "summary": "WebSocket 代理数据面",
      "usage": "需要代理 WebSocket 长连接（实时推送、聊天）时使用。",
      "when_not": "普通 HTTP 请求不需要。",
      "examples": [
        "代理实时消息推送服务"
      ],
      "related": [
        "proxy:http"
      ]
    },
    {
      "id": "proxy:grpc",
      "description": "gRPC 代理数据面",
      "summary": "gRPC 代理数据面",
      "usage": "需要代理 gRPC 双向流服务时使用。",
      "when_not": "REST/HTTP 服务不需要。",
      "examples": [
        "代理 gRPC 微服务"
      ],
      "related": [
        "proxy:http"
      ]
    },
    {
      "id": "admin:config",
      "description": "读取/修改网关配置",
      "parameters": {
        "config_key": {
          "type": "string",
          "description": "允许访问的配置键（空 = 全部）",
          "required": false
        }
      },
      "summary": "读取/修改网关配置",
      "usage": "需要调整网关监听器、路由、上游配置时使用。",
      "when_not": "常规数据面任务严禁授权；仅运维管理员需要。",
      "examples": [
        "修改路由映射"
      ],
      "related": [
        "admin:reload"
      ]
    },
    {
      "id": "admin:reload",
      "description": "热重载配置",
      "summary": "热重载配置",
      "usage": "配置变更后需要无中断热加载时使用。",
      "when_not": "无配置变更任务不需要。",
      "examples": [
        "SIGHUP 触发配置重载"
      ],
      "related": [
        "admin:config"
      ]
    },
    {
      "id": "admin:plugins",
      "description": "管理能力插件（注册/替换/删除）",
      "summary": "管理能力插件（注册/替换/删除）",
      "usage": "需要动态调整能力判定插件（allowlist/denylist/rbac）时使用。",
      "when_not": "纯数据面任务不需要。",
      "examples": [
        "替换 RBAC 插件"
      ],
      "related": [
        "ops:plugins"
      ]
    },
    {
      "id": "admin:policy",
      "description": "策略版本化与回滚",
      "summary": "策略版本化与回滚",
      "usage": "需要管理授权策略版本、执行回滚时使用。",
      "when_not": "只读策略查看用 ops:plugins 即可。",
      "examples": [
        "回滚到上一策略版本"
      ],
      "related": [
        "admin:branch"
      ]
    },
    {
      "id": "admin:branch",
      "description": "策略分支控制（灰度发布）",
      "summary": "策略分支控制（灰度发布）",
      "usage": "需要按 Agent 分组灰度下发不同策略版本时使用。",
      "when_not": "全局统一策略不需要。",
      "examples": [
        "对指定 Agent 灰度新策略"
      ],
      "related": [
        "admin:policy"
      ]
    },
    {
      "id": "admin:renewal",
      "description": "确认续签管理（request/confirm/reject）",
      "summary": "确认续签管理（request/confirm/reject）",
      "usage": "需要管理短命证书的确认续签流程时使用。",
      "when_not": "无短命证书场景不需要。",
      "examples": [
        "确认 Agent 证书续签"
      ],
      "related": [
        "admin:agents"
      ]
    },
    {
      "id": "admin:agents",
      "description": "Agent 目录与踢线管理",
      "summary": "Agent 目录与踢线管理",
      "usage": "需要查看在线 Agent、主动断开异常 Agent 时使用。",
      "when_not": "Agent 自身任务不需要管理其他 Agent。",
      "examples": [
        "踢掉异常 Agent 连接"
      ],
      "related": [
        "admin:connections"
      ]
    },
    {
      "id": "admin:connections",
      "description": "实时连接/接入点查看",
      "summary": "实时连接/接入点查看",
      "usage": "需要监控当前活跃连接、查看接入点时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "查看当前连接数"
      ],
      "related": [
        "ops:metrics"
      ]
    },
    {
      "id": "ops:metrics",
      "description": "读取 Prometheus 指标",
      "summary": "读取 Prometheus 指标",
      "usage": "需要拉取网关监控指标（连接数/PPS/延迟）时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "Prometheus 抓取指标"
      ],
      "related": [
        "ops:health"
      ]
    },
    {
      "id": "ops:plugins",
      "description": "查看能力插件列表",
      "summary": "查看能力插件列表",
      "usage": "需要查看当前加载的插件、其方案定义时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "查看已注册插件"
      ],
      "related": [
        "admin:plugins"
      ]
    },
    {
      "id": "audit:read",
      "description": "读取审计日志",
      "summary": "读取审计日志",
      "usage": "需要查看网关访问/连接审计记录时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "查看连接审计"
      ],
      "related": [
        "audit:verify",
        "audit:search"
      ]
    },
    {
      "id": "audit:verify",
      "description": "验证审计链/Merkle",
      "summary": "验证审计链/Merkle 完整性",
      "usage": "需要验证审计日志哈希链完整性（防篡改）时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "校验审计链"
      ],
      "related": [
        "audit:read"
      ]
    },
    {
      "id": "audit:search",
      "description": "审计全文检索",
      "summary": "审计全文检索",
      "usage": "需要按关键字/时间段检索审计记录时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "搜索某 Agent 的审计记录"
      ],
      "related": [
        "audit:read"
      ]
    },
    {
      "id": "audit:chain",
      "description": "跨网关审计链 DAG 引用",
      "summary": "跨网关审计链 DAG 引用",
      "usage": "需要查看多网关审计链引用关系时使用。只读。",
      "when_not": "无特殊限制，只读。",
      "examples": [
        "查看跨网关审计链"
      ],
      "related": [
        "audit:read"
      ]
    },
    {
      "id": "ops:health",
      "description": "健康检查",
      "summary": "健康检查",
      "usage": "需要探测网关存活状态时使用。公开能力。",
      "when_not": "无限制，通常公开。",
      "examples": [
        "负载均衡健康检查"
      ],
      "related": [
        "ops:metrics"
      ]
    }
  ],
  "roles": {
    "gateway:admin": {
      "display_name": "网关管理员",
      "profiles": [
        "m-admin"
      ],
      "ous": [
        "gateway:admin"
      ],
      "grants": [
        "proxy:*",
        "admin:config",
        "admin:reload",
        "admin:plugins",
        "admin:policy",
        "admin:branch",
        "admin:renewal",
        "admin:agents",
        "admin:connections",
        "ops:metrics",
        "ops:plugins",
        "ops:health",
        "audit:read",
        "audit:verify",
        "audit:search",
        "audit:chain"
      ]
    },
    "gateway:ops": {
      "display_name": "网关运维",
      "profiles": [
        "m-operator"
      ],
      "ous": [
        "gateway:ops"
      ],
      "grants": [
        "proxy:*",
        "admin:reload",
        "admin:renewal",
        "admin:connections",
        "ops:metrics",
        "ops:plugins",
        "ops:health"
      ]
    },
    "gateway:audit": {
      "display_name": "网关审计",
      "profiles": [
        "m-auditor"
      ],
      "ous": [
        "gateway:audit"
      ],
      "grants": [
        "audit:read",
        "audit:verify",
        "audit:search",
        "audit:chain",
        "ops:health"
      ]
    },
    "gateway:read": {
      "display_name": "网关只读",
      "profiles": [
        "m-readonly"
      ],
      "ous": [
        "gateway:read"
      ],
      "grants": [
        "ops:metrics",
        "ops:health"
      ]
    },
    "agent": {
      "display_name": "AI Agent（数据面）",
      "profiles": [
        "agent-proxy"
      ],
      "grants": [
        "proxy:*"
      ]
    }
  }
}
