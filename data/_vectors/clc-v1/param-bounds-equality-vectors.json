[
  {
    "id": "pbe-001",
    "kind": "param-bounds",
    "spec_clause": "CLC-v1 §6.5 (layer 8, JSON type-sensitive equality), §6.2",
    "clc_revision": "CLC-1.15",
    "conformance_class": "CLC-A",
    "grant": {
      "id": "std/database-v1:query:SELECT",
      "param_bounds": {"flag": {"enum": [1]}}
    },
    "request": {
      "id": "std/database-v1:query:SELECT",
      "params": {"flag": true}
    },
    "expect": {"verdict": "deny", "reason": "not_in_enum"},
    "derivation": "true ≠ 1: enum membership is JSON type-sensitive (booleans are never numbers, §6.2)"
  },
  {
    "id": "pbe-002",
    "kind": "param-bounds",
    "spec_clause": "CLC-v1 §6.5 (layer 8, JSON type-sensitive equality), §6.2",
    "clc_revision": "CLC-1.15",
    "conformance_class": "CLC-A",
    "grant": {
      "id": "std/database-v1:query:SELECT",
      "param_bounds": {"flag": {"enum": [true]}}
    },
    "request": {
      "id": "std/database-v1:query:SELECT",
      "params": {"flag": 1}
    },
    "expect": {"verdict": "deny", "reason": "not_in_enum"},
    "derivation": "1 ≠ true: the reverse direction of pbe-001 (a coercing host language must not widen the member set)"
  },
  {
    "id": "pbe-003",
    "kind": "param-bounds",
