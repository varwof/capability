      "id": "std/database-v1:query:SELECT",
      "params": {"flag": "1"}
    },
    "expect": {"verdict": "deny", "reason": "not_in_enum"},
    "derivation": "\"1\" ≠ 1: a string is never a number member"
  },
  {
    "id": "pbe-004",
