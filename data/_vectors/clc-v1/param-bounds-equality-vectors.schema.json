{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varwof.com/schemas/clc-v1/param-bounds-equality-vectors.schema.json",
  "title": "CLC-v1 §6.5 enum type-sensitive-equality test vectors (rev CLC-1.15)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "kind",
      "spec_clause",
      "clc_revision",
      "conformance_class",
      "grant",
      "expect",
      "derivation"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^pbe-[0-9]{3}$",
        "description": "Unique vector identifier"
      },
      "kind": {
        "type": "string",
        "enum": [
          "param-bounds",
          "param-defaults"
        ]
      },
      "spec_clause": {
        "type": "string"
      },
      "clc_revision": {
        "type": "string",
        "pattern": "^CLC-[0-9]+\\.[0-9]+$",
        "description": "CLC language revision the vector declares (§12.1)"
      },
      "conformance_class": {
        "type": "string",
        "enum": ["CLC-A"]
      },
      "grant": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "params": {"type": "object"},
          "param_bounds": {
            "type": "object",
            "description": "§6.5 extended bounds; a key MUST NOT also appear in params"
          }
        },
        "additionalProperties": false
      },
      "request": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "params": {"type": "object"}
        },
        "additionalProperties": false
      },
      "scheme_defaults": {
        "type": "object",
        "description": "§6.5 scheme-declared param_defaults applied before evaluation (kind=param-defaults)"
      },
      "expect": {
        "type": "object",
        "required": ["verdict"],
        "properties": {
          "verdict": {"type": "string", "enum": ["allow", "deny"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      },
      "derivation": {"type": "string"}
    },
    "additionalProperties": false
  }
}
